# Copy to agent/.env and fill in. Never commit the result - .env is gitignored.
#
# Write this file WITHOUT a byte order mark. A BOM makes the first key parse
# as "﻿WEBHOOK_SECRET", so the real variable stays unset and every request
# 401s. PowerShell's `Set-Content -Encoding utf8` adds one; use `printf` on the
# server instead:
#     printf 'OPENROUTER_API_KEY=%s\n' "$KEY" > .env
#
# Values must have no trailing whitespace - a stray newline in a secret becomes
# an embedded newline in an HTTP header and the request is rejected unparsed.

# --- Required ------------------------------------------------------------

# Model access. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here


# --- Required to accept CI webhooks -------------------------------------

# Shared secret GitHub Actions sends as the X-Webhook-Secret header. Must match
# the WEBHOOK_SECRET repository secret in the repo being watched. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=your_secret_here


# --- Required to open pull requests -------------------------------------

# Classic PAT with the `repo` scope, or a fine-grained token with Contents and
# Pull requests write access on the target repo. Prefer fine-grained, scoped to
# the single repo the agent watches.
#
# Without it the agent still diagnoses, fixes and validates, then logs
# "skipping push and PR". With it, private target repos also clone.
GITHUB_TOKEN=your_github_personal_access_token_here


# --- Models (optional) ---------------------------------------------------

# Default is free, so this runs on a new account with no credit on it. Any
# OpenRouter model id works. Free ids end in `:free`; they are slower and less
# consistent at emitting valid JSON than a paid model, which costs the odd
# retried attempt.
#
# OpenRouter retires free slugs without notice; a dead one 404s and the run
# stops with "Model provider unavailable". List the current ones with:
#     curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
#LLM_MODEL=poolside/laguna-s-2.1:free

# Cheaper model for the triage and review nodes. Falls back to LLM_MODEL.
#TRIAGE_MODEL=


# --- Target repo (optional) ----------------------------------------------

# Branch the auto-fix PR is opened against. Set to the target repo's default
# branch; a wrong value throws away a fix that already went green.
#PR_BASE_BRANCH=main

# Container image the candidate fix is validated in. Needs python and pip on
# PATH. Override when the target suite needs system packages, a different
# Python, or a pinned architecture - the Oracle Ampere free tier is arm64, so
# an x86-only wheel needs an explicit image here.
#VALIDATOR_IMAGE=python:3.11-slim

# Seconds one validation run may take, covering pip install plus the suite.
# A timeout counts as a failed attempt, never as a pass.
#VALIDATOR_TIMEOUT=300


# --- Storage (optional) --------------------------------------------------

# SQLite file holding runs, events and incident memory. The webhook server and
# the console must point at the same file to show the same runs.
#MEMORY_DB=~/.sre-agent/memory.db


# --- Console (optional) --------------------------------------------------

# Bind address for the standalone console. The default is loopback, which
# needs no secret. Setting a routable address requires DASHBOARD_SECRET (or
# WEBHOOK_SECRET) - the console refuses to start unprotected, because run rows
# hold repo diffs, CI logs and full model prompts.
#DASHBOARD_HOST=127.0.0.1
#DASHBOARD_PORT=8001

# Read-only console secret. Falls back to WEBHOOK_SECRET, but prefer setting
# this when sharing access: WEBHOOK_SECRET also lets its holder POST a fake CI
# failure, which spends model credits and can push a branch.
#DASHBOARD_SECRET=
